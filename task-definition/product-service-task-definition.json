{
  "family": "product-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::000000000000:role/ecsTaskExecutionRole",
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "product-service",
      "image": "000000000000.dkr.ecr.eu-central-1.localhost.localstack.cloud:4566/product-service:1.0.1",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4001,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "product-service",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "product-service",
          "awslogs-create-group": "true"
        }
      },
      "environment": [
        {
          "name": "FRONTEND_URL",
          "value": "http://frontend.portshop.local:80"
        },
        {
          "name": "IMAGE_URI",
          "value": "http://localstack:4566/portshop-bucket/images/"
        },
        {
          "name": "KEYCLOAK_REALM",
          "value": "portshop-realm"
        },
        {
          "name": "KEYCLOAK_CLIENT_ID",
          "value": "portshop-admin"
        },
        {
          "name": "KEYCLOAK_SERVER_URL",
          "value": "http://keycloak.portshop.local:8080"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "password"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://localstack:4515/db"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "admin_user"
        },
        {
          "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
          "value": "update"
        },
        {
          "name": "SPRING_SQL_INIT_MODE",
          "value": "always"
        },
        {
          "name": "USER_SERVICE_URL",
          "value": "http://user-service.portshop.local:4002"
        }
      ]
    }
  ]
}
