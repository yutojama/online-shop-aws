{
  "family": "order-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::000000000000:role/ecsTaskExecutionRole",
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "order-service",
      "image": "000000000000.dkr.ecr.eu-central-1.localhost.localstack.cloud:4566/order-service:1.0.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4003,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "order-service",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "order-service",
          "awslogs-create-group": "true"
        }
      },
      "environment": [
        {
          "name": "KAFKA_SERVICE_URL",
          "value": "b-1.kafka.0pollj.c24.kafka.eu-central-1.localhost.localstack.cloud:4517,b-2.kafka.0pollj.c24.kafka.eu-central-1.localhost.localstack.cloud:4518"
        },
        {
          "name": "KEYCLOAK_REALM",
          "value": "portshop-realm"
        },
        {
          "name": "KEYCLOAK_CLIENT_ID",
          "value": "portshop-admin"
        },
        {
          "name": "KEYCLOAK_SERVER_URL",
          "value": "http://keycloak.portshop.local:8080"
        },
        {
          "name": "PRODUCT_SERVICE_URL",
          "value": "http://product-service.portshop.local:4001"
        },
        {
          "name": "SPRING_DATASOURCE_PASSWORD",
          "value": "password"
        },
        {
          "name": "SPRING_DATASOURCE_URL",
          "value": "jdbc:postgresql://localstack:4513/db"
        },
        {
          "name": "SPRING_DATASOURCE_USERNAME",
          "value": "admin_user"
        },
        {
          "name": "SPRING_JPA_HIBERNATE_DDL_AUTO",
          "value": "create"
        },
        {
          "name": "SPRING_SQL_INIT_MODE",
          "value": "never"
        },
        {
          "name": "USER_SERVICE_URL",
          "value": "http://user-service.portshop.local:4002"
        }
      ]
    }
  ]
}
