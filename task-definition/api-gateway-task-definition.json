{
  "family": "api-gateway",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::000000000000:role/ecsTaskExecutionRole",
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "api-gateway",
      "image": "000000000000.dkr.ecr.eu-central-1.localhost.localstack.cloud:4566/api-gateway:1.0.0",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 4000,
          "protocol": "tcp"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "api-gateway",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "api-gateway",
          "awslogs-create-group": "true"
        }
      },
      "environment": [
        {
          "name": "KEYCLOAK_CLIENT_ID",
          "value": "portshop-admin"
        },
        {
          "name": "KEYCLOAK_CLIENT_SECRET",
          "value": "fMBKIo1lQVsIgVW0Ln8evxFgU7fGZhbEjTsuUzjDdTegbtrS1ze2U269BCA0W50D7WtXGTteID0BuokhlWFZ12"
        },
        {
          "name": "KEYCLOAK_REALM",
          "value": "portshop-realm"
        },
        {
          "name": "KEYCLOAK_SERVER_URL",
          "value": "http://keycloak.portshop.local:8080"
        },
        {
          "name": "ORDER_SERVICE_URL",
          "value": "http://order-service.portshop.local:4003"
        },
        {
          "name": "PAYMENT_SERVICE_URL",
          "value": "http://payment-service.portshop.local:4004"
        },
        {
          "name": "PRODUCT_SERVICE_URL",
          "value": "http://product-service.portshop.local:4001"
        },
        {
          "name": "SHIPPING_SERVICE_URL",
          "value": "http://shipping-service.portshop.local:4005"
        },
        {
          "name": "SPRING_R2DBC_PASSWORD",
          "value": "password"
        },
        {
          "name": "SPRING_R2DBC_URL",
          "value": "r2dbc:postgresql://localstack:4510/db"
        },
        {
          "name": "SPRING_R2DBC_USERNAME",
          "value": "admin_user"
        },
        {
          "name": "SPRING_SQL_INIT_MODE",
          "value": "always"
        },
        {
          "name": "USER_SERVICE_URL",
          "value": "http://user-service.portshop.local:4002"
        },
        {
          "name": "FRONTEND_CORS_URL",
          "value": "http://frontend.portshop.local:8080"
        }
      ]
    }
  ]
}
