{
  "family": "keycloak",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "executionRoleArn": "arn:aws:iam::000000000000:role/ecsTaskExecutionRole",
  "cpu": "512",
  "memory": "1024",
  "containerDefinitions": [
    {
      "name": "keycloak",
      "image": "000000000000.dkr.ecr.eu-central-1.localhost.localstack.cloud:4566/keycloak:26.7",
      "essential": true,
      "command": ["start-dev"],
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "KC_DB",
          "value": "postgres"
        },
        {
          "name": "KC_DB_URL",
          "value": "jdbc:postgresql://localstack:4511/keycloak"
        },
        {
          "name": "KC_HOSTNAME_STRICT",
          "value": "false"
        },
        {
          "name": "KC_HTTP_ENABLED",
          "value": "true"
        }
      ],
      "secrets": [
        {
          "name": "KC_BOOTSTRAP_ADMIN_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:000000000000:secret:portshop-keycloak-CpoDUi:bootstrap_admin_username::"
        },
        {
          "name": "KC_BOOTSTRAP_ADMIN_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:000000000000:secret:portshop-keycloak-CpoDUi:bootstrap_admin_password::"
        },
        {
          "name": "KC_DB_USERNAME",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:000000000000:secret:portshop-keycloak-CpoDUi:db_username::"
        },
        {
          "name": "KC_DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:000000000000:secret:portshop-keycloak-CpoDUi:db_password::"
        }
      ]
    }
  ]
}
